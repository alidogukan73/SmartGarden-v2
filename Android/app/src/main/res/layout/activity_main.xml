<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/main"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/background"
        android:clipToPadding="false"
        android:fadingEdgeLength="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/primaryNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardMainFixedHeader">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="0dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AVORA.Card.Featured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="12dp"
                        app:cardBackgroundColor="@color/iconBackground"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_auto_mode_24"
                            app:tint="@color/primary" />
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_connected_device"
                            android:textAppearance="@style/TextAppearance.AVORA.Body" />
                        <TextView
                            android:id="@+id/txtDevice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/default_device_name"
                            android:textColor="@color/textPrimary"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardOnlineStatus"
                        style="@style/Widget.AVORA.Card.Success"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp">
                        <TextView
                            android:id="@+id/txtOnline"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="@string/status_online"
                            android:textColor="@color/online"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:id="@+id/layoutHomeZoneCarouselSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_zones_title"
                    android:textColor="@color/textPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/home_zones_subtitle"
                    android:textAppearance="@style/TextAppearance.AVORA.Body" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerHomeZones"
                    android:layout_width="match_parent"
                    android:layout_height="238dp"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none" />
                <LinearLayout
                    android:id="@+id/layoutHomeZoneDots"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeHealth"
                style="@style/Widget.AVORA.Card.Main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="92dp"
                    android:padding="14dp">
                    <TextView
                        android:id="@+id/imgHomeHealthIcon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_ai_icon"
                        android:gravity="center"
                        android:text="@string/symbol_heart"
                        android:textColor="@color/primary"
                        android:textSize="22sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutHomeHealthText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/layoutHomeHealthScore"
                        app:layout_constraintStart_toEndOf="@id/imgHomeHealthIcon"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:id="@+id/txtHomeHealthTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/home_health_summary_accessibility"
                            android:textAppearance="@style/TextAppearance.AVORA.CardTitle"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                        <TextView
                            android:id="@+id/txtHomeHealthDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.AVORA.Body"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/txtHomeHealthTitle" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <LinearLayout
                        android:id="@+id/layoutHomeHealthScore"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">
                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:id="@+id/progressHomeHealthScore"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminate="false"
                                app:indicatorDirectionCircular="clockwise"
                                app:indicatorSize="60dp"
                                app:trackCornerRadius="6dp"
                                app:trackThickness="6dp" />
                            <TextView
                                android:id="@+id/txtHomeHealthScore"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/primary"
                                android:textSize="21sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/home_health_score_title"
                            android:textColor="@color/textSecondary"
                            android:layout_gravity="center"
                            android:textSize="11sp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomeGardenPlan"
                style="@style/Widget.AVORA.Card.Main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <LinearLayout
                    android:id="@+id/layoutHomeGardenPlanContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_home_garden_plan_icon"
                            android:contentDescription="@string/home_garden_plan_title"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_home_garden_plan_24" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/home_garden_plan_title"
                            android:textAppearance="@style/TextAppearance.AVORA.CardTitle" />
                    </LinearLayout>
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardHomeWateringSummary"
                        style="@style/Widget.AVORA.Card.Main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="48dp"
                            android:paddingEnd="4dp">
                            <TextView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_home_garden_plan_icon"
                                android:gravity="center"
                                android:text="@string/symbol_water_drop"
                                android:textSize="18sp" />
                            <TextView
                                android:id="@+id/txtHomeWateringSummary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/textPrimary"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/symbol_chevron_right"
                                android:textColor="@color/primary"
                                android:textSize="28sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <View
                        android:id="@+id/dividerHomeGardenPlan"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="98dp"
                        android:layout_marginEnd="22dp"
                        android:background="@color/divider" />
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardHomeFertilizationSummary"
                        style="@style/Widget.AVORA.Card.Main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="48dp"
                            android:paddingEnd="4dp">
                            <TextView
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_home_garden_plan_icon"
                                android:gravity="center"
                                android:text="@string/symbol_leaf"
                                android:textSize="18sp" />
                            <TextView
                                android:id="@+id/txtHomeFertilizationSummary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="@string/home_fertilization_loading"
                                android:textColor="@color/textPrimary"
                                android:textSize="14sp" />
                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/symbol_chevron_right"
                                android:textColor="@color/primary"
                                android:textSize="28sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <ViewStub
                android:id="@+id/stubHomeWeather"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:layout_height="wrap_content"
                android:layout="@layout/include_home_weather_card" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHomePlantAssistantSummary"
                style="@style/Widget.AVORA.Card.Main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imgHomePlantAssistantSummary"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_ai_icon"
                        android:contentDescription="@string/home_plant_assistant_content_description"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_plant_assistant_logo" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_plant_assistant_title"
                            android:textAppearance="@style/TextAppearance.AVORA.CardTitle" />
                        <TextView
                            android:id="@+id/txtHomePlantAssistantSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/home_plant_assistant_empty"
                            android:textAppearance="@style/TextAppearance.AVORA.Body" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/symbol_chevron_right"
                        android:textColor="@color/primary"
                        android:textSize="30sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMainFixedHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/background"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                tools:ignore="UselessParent">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMainMenu"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="start|center_vertical"
                    android:contentDescription="@string/open_main_menu"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:backgroundTint="@android:color/transparent"
                    app:icon="@drawable/ic_menu_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="25dp"
                    app:iconTint="@color/primary"
                    app:rippleColor="@color/divider" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    tools:ignore="RtlSymmetry">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="44dp"
                        android:layout_height="42dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:scaleX="2.05"
                        android:scaleY="2.05"
                        android:translationY="2dp"
                        android:src="@mipmap/ic_launcher_foreground" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/app_name"
                            android:textAppearance="@style/TextAppearance.AVORA.ScreenTitle"
                            android:textColor="@color/primaryLogo" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/app_subtitle"
                            android:textAppearance="@style/TextAppearance.AVORA.Body" />
                    </LinearLayout>
                </LinearLayout>
                <FrameLayout
                    android:id="@+id/btnMainNotifications"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:clickable="true"
                    android:contentDescription="@string/main_notifications_description"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_header_notification"
                        app:tint="@color/primary" />
                    <TextView
                        android:id="@+id/txtMainNotificationBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/bg_notification_badge"
                        android:gravity="center"
                        android:textColor="@color/card"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <include
        android:id="@+id/primaryNavigation"
        layout="@layout/include_primary_navigation"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
