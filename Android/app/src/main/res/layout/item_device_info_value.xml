<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/txtDeviceInfoRowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.AVORA.Settings.RowTitle" />

    <TextView
        android:id="@+id/txtDeviceInfoRowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="170dp"
        android:textAlignment="viewEnd"
        android:textAppearance="@style/TextAppearance.AVORA.Settings.RowSubtitle" />
</LinearLayout>