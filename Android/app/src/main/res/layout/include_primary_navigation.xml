<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_gravity="bottom"
    app:cardBackgroundColor="@color/card"
    app:cardCornerRadius="0dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/navPrimaryHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_nav_home"
            android:drawableTint="@color/textSecondary"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/nav_home"
            android:textColor="@color/textSecondary"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/navPrimaryPlants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_nav_plants"
            android:drawableTint="@color/textSecondary"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/nav_plant_journal"
            android:textColor="@color/textSecondary"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/navPrimaryAssistant"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_nav_assistant"
            android:drawableTint="@color/textSecondary"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/nav_ai_assistant"
            android:textColor="@color/textSecondary"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/navPrimaryNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_device_health_24"
            android:drawableTint="@color/textSecondary"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/title_device_health"
            android:textColor="@color/textSecondary"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/navPrimarySettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:drawableTop="@drawable/ic_settings_24"
            android:drawableTint="@color/textSecondary"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/nav_settings"
            android:textColor="@color/textSecondary"
            android:textSize="8sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
