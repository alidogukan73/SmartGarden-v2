<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:layout_gravity="bottom"
    app:cardBackgroundColor="@color/card"
    app:cardCornerRadius="0dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp">

        <LinearLayout
            android:id="@+id/navPrimaryHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/navPrimaryHomeIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_nav_home"
                app:tint="@color/textSecondary" />
            <TextView
                android:id="@+id/navPrimaryHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/nav_home"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPrimaryPlants"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/navPrimaryPlantsIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_plant_journal"
                android:src="@drawable/ic_nav_plants"
                app:tint="@color/textSecondary" />
            <TextView
                android:id="@+id/navPrimaryPlantsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/nav_plant_journal"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPrimaryAssistant"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/navPrimaryAssistantIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_ai_assistant"
                android:src="@drawable/ic_nav_assistant"
                app:tint="@color/textSecondary" />
            <TextView
                android:id="@+id/navPrimaryAssistantLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/nav_ai_assistant"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPrimaryNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/navPrimaryNotificationsIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/title_device_health"
                android:src="@drawable/ic_device_health_24"
                app:tint="@color/textSecondary" />
            <TextView
                android:id="@+id/navPrimaryNotificationsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/title_device_health"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPrimarySettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/navPrimarySettingsIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/nav_settings"
                android:src="@drawable/ic_settings_24"
                app:tint="@color/textSecondary" />
            <TextView
                android:id="@+id/navPrimarySettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/nav_settings"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>