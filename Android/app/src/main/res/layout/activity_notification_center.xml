<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="94dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnNotificationBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:contentDescription="Geri"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/symbol_back_arrow"
                    android:textAppearance="@style/TextAppearance.AVORA.BackButton" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Bildirimler"
                    android:textAppearance="@style/TextAppearance.SmartGarden.ScreenTitle" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnNotificationClear"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:contentDescription="Bildirimleri temizle"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_delete_24" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btnNotificationSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:contentDescription="Bildirim ayarları"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings_24" />

            </LinearLayout>
            <TextView
                android:id="@+id/txtNotificationSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.SmartGarden.Body" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotificationFilterAll"
                        style="@style/Widget.SmartGarden.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Tümü" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotificationFilterSaved"
                        style="@style/Widget.SmartGarden.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Kaydedilenler" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotificationFilterRead"
                        style="@style/Widget.SmartGarden.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Okundu" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotificationFilterUnread"
                        style="@style/Widget.SmartGarden.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Okunmadı" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNotificationFilterCategory"
                        style="@style/Widget.SmartGarden.Button.Outlined"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:text="Filtrele" />
                </LinearLayout>
            </HorizontalScrollView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
            <TextView
                android:id="@+id/txtNotificationEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:text="Henüz bildirim yok. Bahçenizde önemli bir gelişme olduğunda burada göreceksiniz."
                android:textAppearance="@style/TextAppearance.SmartGarden.Body" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        layout="@layout/include_primary_navigation" />
</FrameLayout>
