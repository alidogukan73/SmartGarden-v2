<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainMenuSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_menu_bottom_sheet"
    android:clipToOutline="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <View
            android:layout_width="56dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:alpha="0.35"
            android:background="@color/textTertiary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="@color/primaryLight"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:scaleX="1.45"
                    android:scaleY="1.45"
                    android:translationY="3dp"
                    android:src="@mipmap/ic_launcher" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/main_menu_title"
                android:textColor="@color/primary"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/main_menu_subtitle"
            android:textAppearance="@style/TextAppearance.SmartGarden.Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/textPrimary"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVORA Bahçesi"
                    android:textAppearance="@style/TextAppearance.SmartGarden.ScreenTitle" />

                <TextView
                    android:id="@+id/txtMenuConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="● Bağlanıyor · smartgarden-001"
                    android:textAppearance="@style/TextAppearance.SmartGarden.Supporting" />
            </LinearLayout>

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="♧"
                android:textColor="@color/textPrimary"
                android:textSize="24sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartGarden.Card.Main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surfaceGreen">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bugünkü Öneri"
                    android:textColor="@color/primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMenuTodayTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Bahçe verisi hazırlanıyor"
                    android:textColor="@color/textPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMenuTodayDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Sensör ve hava verisi bekleniyor."
                    android:textAppearance="@style/TextAppearance.SmartGarden.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menuCardPlantDoctor"
                style="@style/Widget.SmartGarden.Card.Inner"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#F2ECFF"
                app:rippleColor="@color/accentLight">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="AI Bitki Doktoru"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_plant_doctor_menu" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="AI Bitki\nDoktoru"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="4dp"
                        android:layout_weight="1"
                        android:text="Fotoğraf ve bahçe verisiyle ön değerlendirme"
                        android:textAppearance="@style/TextAppearance.SmartGarden.Body"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Görüntüle  ›"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menuCardAIAssistant"
                style="@style/Widget.SmartGarden.Card.Inner"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surfaceGreen"
                app:rippleColor="@color/accentLight">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="AI Sulama Asistanı" android:scaleType="centerCrop" android:src="@drawable/img_watering_assistant_menu" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="AI Sulama\nAsistanı" android:textColor="@color/textPrimary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:text="Akıllı sulama kararları ve açıklamaları" android:textAppearance="@style/TextAppearance.SmartGarden.Body" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Görüntüle  ›" android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/menuCardFertilization"
                style="@style/Widget.SmartGarden.Card.Inner"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/warningBackground"
                app:rippleColor="@color/accentLight">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <androidx.appcompat.widget.AppCompatImageView android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="AI Gübre Asistanı" android:scaleType="centerCrop" android:src="@drawable/img_fertilization_assistant_menu" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="AI Gübre\nAsistanı" android:textColor="@color/textPrimary" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:text="Beslenme önerileri, plan ve uygulama takibi" android:textAppearance="@style/TextAppearance.SmartGarden.Body" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Görüntüle  ›" android:textColor="@color/warning" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/menuCardStatistics"
            style="@style/Widget.SmartGarden.Card.Inner"
            android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="14dp" android:clickable="true" android:focusable="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                <TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="📊" android:textSize="22sp" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="İstatistikler" android:textColor="@color/textPrimary" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bugünkü ve genel performans" android:textAppearance="@style/TextAppearance.SmartGarden.Body"/></LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="26sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/menuCardHistory" style="@style/Widget.SmartGarden.Card.Inner" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="📋" android:textSize="22sp"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sulama Geçmişi" android:textColor="@color/textPrimary" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tüm sulama kayıtları" android:textAppearance="@style/TextAppearance.SmartGarden.Body"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="26sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/menuCardPlantJournal" style="@style/Widget.SmartGarden.Card.Inner" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="📷" android:textSize="22sp"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bitki Günlüğü" android:textColor="@color/textPrimary" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gelişim fotoğrafları ve gözlemler" android:textAppearance="@style/TextAppearance.SmartGarden.Body"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="26sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/menuCardSeasonReport" style="@style/Widget.SmartGarden.Card.Inner" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="🌿" android:textSize="22sp"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sezon Özeti" android:textColor="@color/textPrimary" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sezon raporları ve analizler" android:textAppearance="@style/TextAppearance.SmartGarden.Body"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="26sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/menuCardHealth" style="@style/Widget.SmartGarden.Card.Inner" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="❤" android:textColor="@color/offline" android:textSize="22sp"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cihaz Sağlığı" android:textColor="@color/textPrimary" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sistem durumu ve kaynak kullanımı" android:textAppearance="@style/TextAppearance.SmartGarden.Body"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="26sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/menuCardSettings" style="@style/Widget.SmartGarden.Card.Inner" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="⚙" android:textSize="22sp"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ayarlar" android:textColor="@color/textPrimary" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sistem ayarları ve sınırlar" android:textAppearance="@style/TextAppearance.SmartGarden.Body"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="26sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/menuCardAbout" style="@style/Widget.SmartGarden.Card.Inner" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp"><TextView android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="ⓘ" android:textSize="22sp"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hakkında" android:textColor="@color/textPrimary" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Uygulama ve geliştirici bilgileri" android:textAppearance="@style/TextAppearance.SmartGarden.Body"/></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="26sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
