<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wateringControlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="@string/symbol_back_arrow"
                android:textColor="@color/textPrimary"
                app:backgroundTint="@android:color/transparent"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/title_watering_control"
                android:textAppearance="@style/TextAppearance.SmartGarden.ScreenTitle"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartGarden.Card.Main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_watering_control"
                    android:textAppearance="@style/TextAppearance.SmartGarden.CardTitle"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/subtitle_pump_and_mode"
                    android:textAppearance="@style/TextAppearance.SmartGarden.Body"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardControlPumpStatus"
                    style="@style/Widget.SmartGarden.Card.Inner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="88dp"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardControlPumpIcon"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="13dp"
                            app:cardBackgroundColor="@color/offlineBackground"
                            app:cardCornerRadius="17dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/imgControlPump"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_pump_24"
                                app:tint="@color/offline"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_pump_status"
                                android:textAppearance="@style/TextAppearance.SmartGarden.Label"/>

                            <TextView
                                android:id="@+id/txtControlPumpState"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/pump_stopped"
                                android:textColor="@color/offline"
                                android:textSize="20sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/txtControlPumpDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/pump_description_idle"
                                android:textAppearance="@style/TextAppearance.SmartGarden.Supporting"/>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchControlPump"
                            style="@style/Widget.SmartGarden.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/manual_relay_test_button"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.SmartGarden.Card.Inner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="82dp"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="11dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="11dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="13dp"
                            app:cardBackgroundColor="@color/surfaceGreen"
                            app:cardCornerRadius="17dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_auto_mode_24"
                                app:tint="@color/primary"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/title_auto_watering"
                                android:textColor="@color/textPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/txtControlAutoDescription"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:maxLines="2"
                                android:text="@string/auto_mode_default_description"
                                android:textAppearance="@style/TextAppearance.SmartGarden.Supporting"/>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchControlAuto"
                            style="@style/Widget.SmartGarden.Switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/manual_valves_title"
                    android:textAppearance="@style/TextAppearance.SmartGarden.CardTitle"/>

                <TextView
                    android:id="@+id/txtManualValveSafety"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/manual_valves_simulation"
                    android:textAppearance="@style/TextAppearance.SmartGarden.Body"/>

                <LinearLayout
                    android:id="@+id/layoutManualValves"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnValveSetup"
                    style="@style/Widget.SmartGarden.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/valve_setup_button"
                    app:icon="@drawable/ic_settings_24"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnControlPump"
                    style="@style/Widget.SmartGarden.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="15dp"
                    android:text="@string/manual_relay_test_button"
                    android:visibility="gone"
                    app:icon="@drawable/ic_water_drop_24"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/textOnPrimary"/>

                <TextView
                    android:id="@+id/txtControlSafety"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center"
                    android:text="@string/manual_relay_test_hint"
                    android:textColor="@color/textTertiary"
                    android:textSize="10sp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
