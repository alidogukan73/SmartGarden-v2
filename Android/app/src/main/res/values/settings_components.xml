<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Ayarlar ekranlarının tek merkezden yönetilen ölçüleri -->
    <dimen name="settings_screen_horizontal_padding">16dp</dimen>
    <dimen name="settings_toolbar_height">60dp</dimen>
    <dimen name="settings_section_spacing">20dp</dimen>
    <dimen name="settings_row_height">68dp</dimen>
    <dimen name="settings_row_corner_radius">16dp</dimen>
    <dimen name="settings_row_horizontal_padding">12dp</dimen>
    <dimen name="settings_icon_box_size">40dp</dimen>
    <dimen name="settings_icon_size">22dp</dimen>
    <dimen name="settings_quick_card_width">88dp</dimen>
    <dimen name="settings_quick_card_height">96dp</dimen>
    <dimen name="settings_component_gap">10dp</dimen>

    <!-- Ayarlar menüsünde kullanılan kartlar -->
    <style name="Widget.AVORA.Settings.NavigationCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">@dimen/settings_row_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.AVORA.Settings.QuickCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surfaceSoft</item>
        <item name="cardCornerRadius">@dimen/settings_row_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.AVORA.Settings.IconBox" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/iconBackground</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Ayarlar menüsünde kullanılan yazı biçimleri -->
    <style name="TextAppearance.AVORA.Settings.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AVORA.Settings.Category" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AVORA.Settings.RowTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.AVORA.Settings.RowSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/textSecondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="TextAppearance.AVORA.Settings.QuickTitle" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
